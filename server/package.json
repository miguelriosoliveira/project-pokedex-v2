{
	"name": "@project-pokedex/server",
	"version": "1.0.0",
	"license": "MIT",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"predev": "docker compose up -d",
		"dev": "tsx watch --env-file .env src/server.ts",
		"db:populate": "tsx --env-file-if-exists .env src/scripts/populateDb.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"lint": "biome check --write src",
		"test": "vitest",
		"test:cov": "vitest run --coverage",
		"test:cov:staged": "vitest related --run --coverage"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"axios-cache-interceptor": "^1.12.3",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"http-status-codes": "^2.3.0",
		"mongodb-memory-server": "^11.2.0",
		"mongoose": "^9.9.4",
		"morgan": "^1.12.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pokenode-ts": "^2.3.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.4.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.0",
		"husky": "^9.1.7",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
