{
	"name": "@project-pokedex/server",
	"version": "1.0.0",
	"license": "MIT",
	"engines": {
		"node": "24.22.0"
	},
	"scripts": {
		"predev": "docker compose up -d",
		"dev": "tsx watch --env-file .env src/server.ts",
		"db:populate": "tsx --env-file-if-exists .env src/scripts/populateDb.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"lint": "biome check --write src",
		"test": "vitest",
		"test:cov": "vitest run --coverage",
		"test:staged": "vitest related --run"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"axios-cache-interceptor": "^1.13.0",
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"http-status-codes": "^2.3.0",
		"mongodb-memory-server": "^11.3.0",
		"mongoose": "^9.11.2",
		"morgan": "^1.12.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pokenode-ts": "^4.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.6.5",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.5",
		"husky": "^9.1.7",
		"supertest": "^7.3.1",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
