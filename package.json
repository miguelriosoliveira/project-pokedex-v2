{
	"name": "project-pokedex",
	"version": "1.0.0",
	"author": "Miguel Rios <miguelriosoliveira@gmail.com>",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"workspaces": {
		"packages": [
			"server",
			"web"
		]
	},
	"scripts": {
		"server": "pnpm --filter @project-pokedex/server dev",
		"web": "pnpm --filter @project-pokedex/web dev",
		"dev": "pnpm -r --parallel dev",
		"lint": "pnpm -r --parallel lint",
		"test": "pnpm -r --parallel test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"typescript": "^7.0.2"
	}
}
